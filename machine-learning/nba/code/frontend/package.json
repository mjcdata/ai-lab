{
  "name": "nba-similarity-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-snapshot.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-snapshot.mjs && next build --webpack",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "test": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "package:vercel": "node scripts/prepare-vercel.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "engines": {
    "node": "24.x"
  }
}
